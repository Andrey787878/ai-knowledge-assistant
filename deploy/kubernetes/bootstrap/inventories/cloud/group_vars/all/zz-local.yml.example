# Local-only overrides (copy to zz-local.yml and set real CIDR values).
# zz-local.yml is gitignored and loaded after main.yml.
#
# Shared admin SSH CIDR list used by every host group for the 22/tcp rule.
# Required for the firewall role on both k3s and runner hosts.

firewall_admin_ssh_sources:
  - 198.51.100.10/32

# k3s-specific CIDR overrides live in:
# inventories/cloud/group_vars/k3s_hosts/zz-local.yml
# Runner-specific secrets live in:
# inventories/cloud/group_vars/github_runners/zz-local.yml

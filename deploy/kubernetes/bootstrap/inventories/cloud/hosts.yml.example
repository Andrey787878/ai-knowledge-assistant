---
# Example inventory for Kubernetes bootstrap (single-node k3s + optional runner).
# Usage:
# 1) Copy this file to hosts.yml (or generate via terraform sync_inventory.sh)
# 2) Replace IPs with real values from Terraform outputs
# 3) Keep aliases `k3s` and `runner` unchanged unless you also update
#    playbook/role references
#
# Variable meaning:
# - ansible_host: address Ansible uses for SSH
# - private_ip: internal address used by firewall/service checks
#
# The github_runners group is only present when Terraform creates the runner VM
# (runner_enabled = true). When the runner is disabled the group is absent and
# the second play in playbooks/site.yml is skipped.
all:
  children:
    k3s_hosts:
      hosts:
        k3s:
          ansible_host: 198.51.100.10
          private_ip: 10.20.0.3
    github_runners:
      hosts:
        runner:
          ansible_host: 198.51.100.11
          private_ip: 10.20.0.4
